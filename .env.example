# ---------------- Database (Aiven MySQL) ----------------
# Aiven console -> your MySQL service -> Overview -> Connection information
DB_HOST=mysql-xxxxxxx-yourproject.aivencloud.com
DB_PORT=12345
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=
# SSL is required by Aiven. Set to false only for a local MySQL.
DB_SSL=true
# Optional: paste the contents of Aiven's "CA certificate" (ca.pem) to
# verify the server certificate. Newlines can be written as \n.
DB_CA_CERT=

# ---------------- Auth ----------------
JWT_SECRET=change-me-to-a-long-random-string

# ---------------- Keep-alive / auto-wake ----------------
# Any long random string. Pingers must send it as
# "Authorization: Bearer <CRON_SECRET>" or as ?key=<CRON_SECRET>.
CRON_SECRET=change-me-too

# Lets the app power the Aiven service back on by itself if it ever does
# get switched off. Aiven console -> top-right user menu -> Tokens ->
# Generate token. Project and service names are shown in the console URL
# and on the service page.
AIVEN_API_TOKEN=
AIVEN_PROJECT=
AIVEN_SERVICE=

# ---------------- First admin (npm run seed:admin) ----------------
ADMIN_NAME=Coach Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password
