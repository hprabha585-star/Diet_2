# MongoDB Atlas connection string (free M0 tier)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fastcoach?retryWrites=true&w=majority

# JWT secret - generate a long random string
JWT_SECRET=replace_this_with_a_long_random_secret

# Port (Render sets this automatically, safe to leave)
PORT=5000

# Comma separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5500,https://your-frontend.onrender.com

# Used once by npm run seed:admin to create the first coach account
ADMIN_NAME=Coach Admin
ADMIN_EMAIL=admin@fastcoach.app
ADMIN_PASSWORD=change_this_password
