{
  "name": "fastcoach-backend",
  "version": "2.1.0",
  "description": "FastCoach - coach-led fasting & diet cohort + self-guided tracker (MySQL). Self-migrating: just restart the app after deploying, no SSH required.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed:admin": "node utils/seedAdmin.js",
    "check:passwords": "node utils/checkPasswordHashes.js",
    "migrate": "node utils/migrate.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0",
    "sequelize": "^6.37.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "engines": { "node": ">=18.0.0" }
}
